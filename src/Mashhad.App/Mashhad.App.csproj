<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Mashhad.App</RootNamespace>
    <AssemblyName>Mashhad</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Mashhad.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU'">x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged (plain .exe) and fully self-contained: no .NET or Windows App SDK runtime install needed. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs provides Main (single-instance redirection). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <SatelliteResourceLanguages>en;ar</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.260224002" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Mashhad.Core\Mashhad.Core.csproj" />
    <ProjectReference Include="..\Mashhad.Editing\Mashhad.Editing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Assets\**" />
    <None Remove="Assets\**" />
    <Content Include="Assets\*.png;Assets\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Native engines fetched by scripts/fetch-deps.ps1 into /native (not committed). -->
  <ItemGroup Condition="Exists('..\..\native\mpv')">
    <None Include="..\..\native\mpv\**" Link="mpv\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\native\ffmpeg')">
    <None Include="..\..\native\ffmpeg\**" Link="ffmpeg\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
