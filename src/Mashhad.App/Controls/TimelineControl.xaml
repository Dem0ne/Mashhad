<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Mashhad.App.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="28"
    FlowDirection="LeftToRight"
    IsTabStop="False">
    <Grid x:Name="Surface" Background="Transparent"
          PointerPressed="Surface_PointerPressed"
          PointerMoved="Surface_PointerMoved"
          PointerReleased="Surface_PointerReleased"
          PointerCaptureLost="Surface_PointerCaptureLost"
          SizeChanged="Surface_SizeChanged">
        <Rectangle x:Name="Track" Height="4" RadiusX="2" RadiusY="2" Margin="8,0" VerticalAlignment="Center"
                   Fill="{ThemeResource ControlStrongFillColorDefaultBrush}" Opacity="0.45" />
        <Canvas x:Name="Marks" IsHitTestVisible="False" />
        <Rectangle x:Name="Played" Height="4" RadiusX="2" RadiusY="2" Margin="8,0,0,0" Width="0"
                   HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False"
                   Fill="{ThemeResource AccentFillColorDefaultBrush}" />
        <Ellipse x:Name="Thumb" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center"
                 IsHitTestVisible="False" Fill="{ThemeResource AccentFillColorDefaultBrush}"
                 Stroke="{ThemeResource ControlSolidFillColorDefaultBrush}" StrokeThickness="2">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="ThumbShift" X="1" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
