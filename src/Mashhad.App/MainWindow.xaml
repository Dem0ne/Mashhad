<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Mashhad.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Mashhad.App"
    xmlns:controls="using:Mashhad.App.Controls">

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop"
          Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (custom drag region). Caption buttons stay on the right in every language. -->
        <Grid x:Name="TitleBarArea" FlowDirection="LeftToRight" Padding="14,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleLogo" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" Text="Mashhad" />
        </Grid>

        <!-- Content: video surface + side panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- The libmpv child window is positioned exactly over this element. -->
            <Border x:Name="VideoArea" Background="Black" SizeChanged="VideoArea_SizeChanged">
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14" Padding="24">
                    <Image x:Name="EmptyLogo" Width="96" Height="96" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyTitle" HorizontalAlignment="Center" FontSize="26" FontWeight="SemiBold"
                               Foreground="White" local:L.Text="App.Name" />
                    <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="460" Foreground="#B8FFFFFF" local:L.Text="Empty.Hint" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                        <Button x:Name="EmptyOpenButton" Style="{ThemeResource AccentButtonStyle}" Click="OpenFile_Click"
                                local:L.Text="Menu.OpenFile" />
                        <Button x:Name="EmptyOpenFolderButton" Click="OpenFolder_Click" local:L.Text="Menu.OpenFolder" />
                    </StackPanel>
                    <TextBlock x:Name="EmptyError" Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center"
                               TextWrapping="Wrap" MaxWidth="520" Foreground="#FFB4A0" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>

            <Grid x:Name="SidePanel" Grid.Column="1" Width="340" Visibility="Collapsed"
                  Background="{ThemeResource LayerFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Padding="16,10,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SidePanelTitle" VerticalAlignment="Center" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <Button Grid.Column="1" Style="{StaticResource BarButton}" Click="CloseSidePanel_Click" local:L.Tip="Panel.Close">
                        <FontIcon Style="{StaticResource BarIcon}" FontSize="12" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!-- Info / EXIF -->
                <ScrollViewer x:Name="InfoPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InfoRows" Padding="16,4,16,16" Spacing="10" />
                </ScrollViewer>

                <!-- Playlist / gallery -->
                <ListView x:Name="PlaylistView" Grid.Row="1" Visibility="Collapsed" SelectionMode="Single"
                          SelectionChanged="PlaylistView_SelectionChanged" Padding="4,0,4,8" />

                <!-- Segments -->
                <Grid x:Name="SegmentsPanel" Grid.Row="1" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SegmentsHint" Margin="16,0,16,8" TextWrapping="Wrap" Opacity="0.7"
                               Style="{ThemeResource CaptionTextBlockStyle}" local:L.Text="Edit.Hint" />
                    <ListView x:Name="SegmentsView" Grid.Row="1" SelectionMode="Single"
                              SelectionChanged="SegmentsView_SelectionChanged" Padding="4,0,4,8" />
                    <StackPanel Grid.Row="2" Padding="16,8,16,16" Spacing="8">
                        <TextBlock x:Name="KeyframeStatus" TextWrapping="Wrap" Opacity="0.7" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="InvertSegments_Click" local:L.Text="Edit.Invert" local:L.Tip="Edit.InvertTip" />
                            <Button Click="ClearSegments_Click" local:L.Text="Edit.Clear" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPanel" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="16,4,16,20" Spacing="14">
                        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Stretch" local:L.Text="Settings.Language"
                                  SelectionChanged="Setting_Changed">
                            <ComboBoxItem Tag="system" local:L.Text="Settings.SystemDefault" />
                            <ComboBoxItem Tag="en" Content="English" />
                            <ComboBoxItem Tag="ar" Content="العربية" />
                        </ComboBox>
                        <ComboBox x:Name="ThemeBox" HorizontalAlignment="Stretch" local:L.Text="Settings.Theme"
                                  SelectionChanged="Setting_Changed">
                            <ComboBoxItem Tag="System" local:L.Text="Settings.SystemDefault" />
                            <ComboBoxItem Tag="Dark" local:L.Text="Settings.Dark" />
                            <ComboBoxItem Tag="Light" local:L.Text="Settings.Light" />
                        </ComboBox>
                        <ToggleSwitch x:Name="HwdecSwitch" local:L.Text="Settings.Hwdec" Toggled="Setting_Changed" />
                        <ToggleSwitch x:Name="ResumeSwitch" local:L.Text="Settings.Resume" Toggled="Setting_Changed" />
                        <ToggleSwitch x:Name="WrapSwitch" local:L.Text="Settings.Wrap" Toggled="Setting_Changed" />
                        <ToggleSwitch x:Name="SingleInstanceSwitch" local:L.Text="Settings.SingleInstance" Toggled="Setting_Changed" />
                        <NumberBox x:Name="SlideshowSecondsBox" Minimum="1" Maximum="3600" SmallChange="1"
                                   SpinButtonPlacementMode="Inline" local:L.Text="Settings.SlideshowSeconds"
                                   ValueChanged="SlideshowSeconds_Changed" />
                        <ToggleSwitch x:Name="SlideshowLoopSwitch" local:L.Text="Settings.SlideshowLoop" Toggled="Setting_Changed" />
                        <ToggleSwitch x:Name="SlideshowShuffleSwitch" local:L.Text="Settings.SlideshowShuffle" Toggled="Setting_Changed" />
                        <ComboBox x:Name="ScreenshotFormatBox" HorizontalAlignment="Stretch" local:L.Text="Settings.ScreenshotFormat"
                                  SelectionChanged="Setting_Changed">
                            <ComboBoxItem Tag="png" Content="PNG" />
                            <ComboBoxItem Tag="jpg" Content="JPEG" />
                            <ComboBoxItem Tag="webp" Content="WebP" />
                        </ComboBox>
                        <StackPanel Spacing="6">
                            <TextBlock local:L.Text="Settings.Folders" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <Button HorizontalAlignment="Stretch" Click="ChooseScreenshotFolder_Click" local:L.Text="Settings.ScreenshotFolder" />
                            <Button HorizontalAlignment="Stretch" Click="ChooseExportFolder_Click" local:L.Text="Settings.ExportFolder" />
                            <Button HorizontalAlignment="Stretch" Click="ChooseFfmpegFolder_Click" local:L.Text="Settings.FfmpegFolder" />
                            <TextBlock x:Name="FoldersSummary" TextWrapping="Wrap" Opacity="0.7" IsTextSelectionEnabled="True"
                                       Style="{ThemeResource CaptionTextBlockStyle}" />
                        </StackPanel>
                        <Button HorizontalAlignment="Stretch" Click="DefaultApps_Click" local:L.Text="Settings.DefaultApp" />
                        <TextBlock x:Name="AboutText" TextWrapping="Wrap" Opacity="0.7" IsTextSelectionEnabled="True"
                                   Style="{ThemeResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status / progress strip -->
        <Grid x:Name="StatusBar" Grid.Row="2" Visibility="Collapsed" Padding="14,6" ColumnSpacing="10"
              Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <ProgressBar x:Name="StatusProgress" Grid.Column="1" Width="180" Maximum="1" VerticalAlignment="Center" Visibility="Collapsed" />
            <Button x:Name="StatusCancel" Grid.Column="2" Visibility="Collapsed" Click="StatusCancel_Click" local:L.Text="Common.Cancel" />
            <Button x:Name="StatusReveal" Grid.Column="3" Visibility="Collapsed" Click="StatusReveal_Click" local:L.Text="Status.ShowInFolder" />
            <Button Grid.Column="4" Style="{StaticResource BarButton}" Click="StatusClose_Click" local:L.Tip="Panel.Close">
                <FontIcon Style="{StaticResource BarIcon}" FontSize="12" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <!-- Bottom chrome -->
        <StackPanel x:Name="BottomBar" Grid.Row="3" Padding="10,4,10,8"
                    PointerEntered="Chrome_PointerEntered" PointerExited="Chrome_PointerExited">

            <!-- Crop bar (images) -->
            <StackPanel x:Name="CropBar" Orientation="Horizontal" Spacing="10" Visibility="Collapsed" Margin="4,2,4,6">
                <TextBlock VerticalAlignment="Center" local:L.Text="Crop.Hint" />
                <TextBlock x:Name="CropSizeText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <Button Style="{ThemeResource AccentButtonStyle}" Click="CropApply_Click" local:L.Text="Crop.Save" />
                <Button Click="CropCancel_Click" local:L.Text="Common.Cancel" />
            </StackPanel>

            <!-- Lossless edit bar (videos) -->
            <ScrollViewer x:Name="EditBar" Visibility="Collapsed" Margin="0,0,0,2"
                          HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Style="{StaticResource BarTextButton}" Click="SetIn_Click" local:L.Text="Edit.SetIn" local:L.Tip="Edit.SetInTip" />
                    <Button Style="{StaticResource BarTextButton}" Click="SetOut_Click" local:L.Text="Edit.SetOut" local:L.Tip="Edit.SetOutTip" />
                    <Button Style="{StaticResource BarTextButton}" Click="AddSegment_Click" local:L.Text="Edit.Add" local:L.Tip="Edit.AddTip" />
                    <Button Style="{StaticResource BarTextButton}" Click="SplitSegment_Click" local:L.Text="Edit.Split" local:L.Tip="Edit.SplitTip" />
                    <Button Style="{StaticResource BarTextButton}" Click="RemoveSegment_Click" local:L.Text="Edit.Remove" local:L.Tip="Edit.RemoveTip" />
                    <AppBarSeparator />
                    <Button Style="{StaticResource BarTextButton}" Click="PrevKeyframe_Click" local:L.Text="Edit.PrevKeyframe" local:L.Tip="Edit.PrevKeyframeTip" />
                    <Button Style="{StaticResource BarTextButton}" Click="NextKeyframe_Click" local:L.Text="Edit.NextKeyframe" local:L.Tip="Edit.NextKeyframeTip" />
                    <AppBarSeparator />
                    <CheckBox x:Name="SnapCheck" MinWidth="0" VerticalAlignment="Center" Click="EditOption_Click"
                              local:L.Text="Edit.Snap" local:L.Tip="Edit.SnapTip" />
                    <CheckBox x:Name="MergeCheck" MinWidth="0" VerticalAlignment="Center" Click="EditOption_Click"
                              local:L.Text="Edit.Merge" local:L.Tip="Edit.MergeTip" />
                    <AppBarSeparator />
                    <Button Style="{ThemeResource AccentButtonStyle}" Height="32" Click="Export_Click" local:L.Text="Edit.Export" local:L.Tip="Edit.ExportTip" />
                    <Button Style="{StaticResource BarTextButton}" local:L.Text="Edit.More">
                        <Button.Flyout>
                            <MenuFlyout ShouldConstrainToRootBounds="False" Placement="Top">
                                <MenuFlyoutItem Click="ExportFrame_Click" local:L.Text="Edit.ExportFrame" />
                                <MenuFlyoutItem Click="ExportFrames_Click" local:L.Text="Edit.ExportFrames" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Tag=".mkv" Click="Remux_Click" local:L.Text="Edit.RemuxMkv" />
                                <MenuFlyoutItem Tag=".mp4" Click="Remux_Click" local:L.Text="Edit.RemuxMp4" />
                                <MenuFlyoutItem Tag=".mov" Click="Remux_Click" local:L.Text="Edit.RemuxMov" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="ShowSegments_Click" local:L.Text="Edit.ShowSegments" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <TextBlock x:Name="SegmentSummary" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.75" />
                </StackPanel>
            </ScrollViewer>

            <!-- Seek bar (video / audio) -->
            <Grid x:Name="TimelineRow" Visibility="Collapsed" ColumnSpacing="10" FlowDirection="LeftToRight" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PositionText" VerticalAlignment="Center" FontFamily="Consolas" Text="00:00" MinWidth="44" TextAlignment="Right" />
                <controls:TimelineControl x:Name="Timeline" Grid.Column="1" />
                <TextBlock x:Name="DurationText" Grid.Column="2" VerticalAlignment="Center" FontFamily="Consolas" Text="00:00" MinWidth="44" />
            </Grid>

            <!-- Transport and tools -->
            <Grid x:Name="ControlRow" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Left">
                    <Button Style="{StaticResource BarButton}" local:L.Tip="Bar.Open">
                        <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE8E5;" />
                        <Button.Flyout>
                            <MenuFlyout ShouldConstrainToRootBounds="False" Placement="Top">
                                <MenuFlyoutItem Click="OpenFile_Click" local:L.Text="Menu.OpenFile" />
                                <MenuFlyoutItem Click="OpenFolder_Click" local:L.Text="Menu.OpenFolder" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Click="TogglePlaylist_Click" local:L.Tip="Bar.Playlist">
                        <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE8FD;" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" Click="ToggleInfo_Click" local:L.Tip="Bar.Info">
                        <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE946;" />
                    </Button>
                    <TextBlock x:Name="IndexText" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.7" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" FlowDirection="LeftToRight">
                    <!-- image tools -->
                    <StackPanel x:Name="ImageTools" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
                        <Button Style="{StaticResource BarButton}" Click="RotateCcw_Click" local:L.Tip="Image.RotateCcw">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE7AD;">
                                <FontIcon.RenderTransform>
                                    <ScaleTransform ScaleX="-1" CenterX="8" />
                                </FontIcon.RenderTransform>
                            </FontIcon>
                        </Button>
                        <Button Style="{StaticResource BarButton}" Click="RotateCw_Click" local:L.Tip="Image.RotateCw">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE7AD;" />
                        </Button>
                        <Button Style="{StaticResource BarButton}" Click="Crop_Click" local:L.Tip="Image.Crop">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE7A8;" />
                        </Button>
                        <Button x:Name="SaveImageButton" Style="{StaticResource BarButton}" Click="SaveImage_Click" IsEnabled="False"
                                local:L.Tip="Image.SaveCopy">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE74E;" />
                        </Button>
                        <AppBarSeparator />
                    </StackPanel>

                    <Button Style="{StaticResource BarButton}" Click="Previous_Click" local:L.Tip="Bar.Previous">
                        <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE892;" />
                    </Button>
                    <StackPanel x:Name="VideoTransport" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
                        <Button Style="{StaticResource BarButton}" Click="FrameBack_Click" local:L.Tip="Bar.FrameBack">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE76B;" />
                        </Button>
                    </StackPanel>
                    <Button x:Name="PlayButton" Style="{StaticResource BarButton}" Width="46" Click="PlayPause_Click" local:L.Tip="Bar.PlayPause">
                        <FontIcon x:Name="PlayIcon" Style="{StaticResource BarIcon}" FontSize="20" Glyph="&#xE768;" />
                    </Button>
                    <StackPanel x:Name="VideoTransport2" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
                        <Button Style="{StaticResource BarButton}" Click="FrameForward_Click" local:L.Tip="Bar.FrameForward">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE76C;" />
                        </Button>
                    </StackPanel>
                    <Button Style="{StaticResource BarButton}" Click="Next_Click" local:L.Tip="Bar.Next">
                        <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE893;" />
                    </Button>

                    <!-- zoom tools -->
                    <StackPanel x:Name="ZoomTools" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
                        <AppBarSeparator />
                        <Button Style="{StaticResource BarButton}" Click="ZoomOut_Click" local:L.Tip="Image.ZoomOut">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE71F;" />
                        </Button>
                        <Button x:Name="ZoomButton" Style="{StaticResource BarTextButton}" MinWidth="58" Click="ZoomFit_Click"
                                Content="100%" local:L.Tip="Image.ZoomFit" />
                        <Button Style="{StaticResource BarButton}" Click="ZoomIn_Click" local:L.Tip="Image.ZoomIn">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE8A3;" />
                        </Button>
                        <Button Style="{StaticResource BarTextButton}" Click="ZoomActual_Click" Content="1:1" local:L.Tip="Image.ZoomActual" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                    <StackPanel x:Name="VideoTools" Orientation="Horizontal" Spacing="2" Visibility="Collapsed">
                        <Button Style="{StaticResource BarButton}" Click="Mute_Click" local:L.Tip="Bar.Mute">
                            <FontIcon x:Name="VolumeIcon" Style="{StaticResource BarIcon}" Glyph="&#xE767;" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="90" Minimum="0" Maximum="100" VerticalAlignment="Center"
                                IsTabStop="False" FlowDirection="LeftToRight" IsThumbToolTipEnabled="False"
                                ValueChanged="VolumeSlider_ValueChanged" />
                        <Button x:Name="SpeedButton" Style="{StaticResource BarTextButton}" MinWidth="52" Content="1×" local:L.Tip="Bar.Speed">
                            <Button.Flyout>
                                <MenuFlyout x:Name="SpeedMenu" ShouldConstrainToRootBounds="False" Placement="Top" Opening="SpeedMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button Style="{StaticResource BarButton}" local:L.Tip="Bar.Audio">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE8D6;" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="AudioMenu" ShouldConstrainToRootBounds="False" Placement="Top" Opening="AudioMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <Button Style="{StaticResource BarButton}" local:L.Tip="Bar.Subtitles">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE7F0;" />
                            <Button.Flyout>
                                <MenuFlyout x:Name="SubtitleMenu" ShouldConstrainToRootBounds="False" Placement="Top" Opening="SubtitleMenu_Opening" />
                            </Button.Flyout>
                        </Button>
                        <ToggleButton x:Name="EditToggle" Style="{StaticResource BarToggle}" Click="EditToggle_Click" local:L.Tip="Bar.Edit">
                            <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE8C6;" />
                        </ToggleButton>
                    </StackPanel>
                    <ToggleButton x:Name="SlideshowToggle" Style="{StaticResource BarToggle}" Click="SlideshowToggle_Click" local:L.Tip="Bar.Slideshow">
                        <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE786;" />
                    </ToggleButton>
                    <Button Style="{StaticResource BarButton}" Click="Fullscreen_Click" local:L.Tip="Bar.Fullscreen">
                        <FontIcon x:Name="FullscreenIcon" Style="{StaticResource BarIcon}" Glyph="&#xE740;" />
                    </Button>
                    <Button Style="{StaticResource BarButton}" local:L.Tip="Bar.More">
                        <FontIcon Style="{StaticResource BarIcon}" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout ShouldConstrainToRootBounds="False" Placement="Top">
                                <MenuFlyoutItem Click="Screenshot_Click" local:L.Text="Menu.Screenshot" />
                                <MenuFlyoutItem x:Name="AbLoopItem" Click="AbLoop_Click" local:L.Text="Menu.AbLoop" />
                                <ToggleMenuFlyoutItem x:Name="LoopFileItem" Click="LoopFile_Click" local:L.Text="Menu.LoopFile" />
                                <ToggleMenuFlyoutItem x:Name="ShuffleItem" Click="Shuffle_Click" local:L.Text="Menu.Shuffle" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="ShowInExplorer_Click" local:L.Text="Menu.ShowInExplorer" />
                                <MenuFlyoutItem Click="SavePlaylist_Click" local:L.Text="Menu.SavePlaylist" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="Settings_Click" local:L.Text="Menu.Settings" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
