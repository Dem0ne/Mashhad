<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Mashhad.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Accent ramp derived from the logo gradient: teal #2FD8B8 -> blue #16A3D9 -> indigo #2F5BE3. -->
            <Color x:Key="SystemAccentColor">#16A3D9</Color>
            <Color x:Key="SystemAccentColorLight1">#22BDD0</Color>
            <Color x:Key="SystemAccentColorLight2">#2FD8B8</Color>
            <Color x:Key="SystemAccentColorLight3">#8AEBD8</Color>
            <Color x:Key="SystemAccentColorDark1">#2F5BE3</Color>
            <Color x:Key="SystemAccentColorDark2">#2448B8</Color>
            <Color x:Key="SystemAccentColorDark3">#1A3488</Color>

            <Color x:Key="BrandTeal">#2FD8B8</Color>
            <Color x:Key="BrandBlue">#16A3D9</Color>
            <Color x:Key="BrandIndigo">#2F5BE3</Color>
            <LinearGradientBrush x:Key="BrandGradientBrush" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#2FD8B8" />
                <GradientStop Offset="0.5" Color="#16A3D9" />
                <GradientStop Offset="1" Color="#2F5BE3" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="SegmentBrush" Color="#2FD8B8" Opacity="0.55" />
            <SolidColorBrush x:Key="SegmentCurrentBrush" Color="#2FD8B8" />
            <SolidColorBrush x:Key="LoopMarkerBrush" Color="#F2B84B" />

            <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="BarTextButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="BarToggle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="38" />
                <Setter Property="Height" Value="36" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
            <Style x:Key="BarIcon" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="{ThemeResource SymbolThemeFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
